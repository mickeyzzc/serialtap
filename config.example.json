{
  "root": "/home/YOU/serialtap-logs",
  "baud": 115200,
  "poll_interval_ms": 1000,
  "silent_reopen_s": 0,
  "reopen_min_s": 5,
  "reopen_max_s": 60,
  "rotate_max_mb": 64,
  "retention_days": 14,
  "exclude": [],
  "names": [
    { "match": "Espressif_USB_JTAG_serial_debug_unit_XX:XX:XX:XX:XX:XX", "name": "board-a" },
    { "match": "USB_Single_Serial_XXXXXXXXXXXX", "name": "board-b" }
  ],
  "signatures_extra": ["NO-SOI"],
  "proxy_tap_exclude": "",
  "dtr_hold": ["^rp2040-"],
  "elf_map": {
    "board-a": "/path/to/your/firmware/build/app.elf"
  },
  // —— mesh：多 PC 互联（默认关）。每台机器配同一个 mesh_key ——
  "mesh_enabled": false,
  "mesh_key": "serialtap mesh keygen 生成的口令，所有互管 PC 一致",
  "mesh_name": "bench1",
  "mesh_port": 8802,
  "mesh_announce_s": 5,
  "mesh_peers": []
}
