[Unit]
Description=serialtap — USB serial log collector
Documentation=https://github.com/mickeyzzc/serialtap

[Service]
# 用户级 systemd 服务（systemctl --user）。开机自启需:
#   loginctl enable-linger $USER
ExecStart=%h/.local/bin/serialtap run --config %h/.config/serialtap/config.json
Restart=on-failure
RestartSec=3
WorkingDirectory=%h

[Install]
WantedBy=default.target
